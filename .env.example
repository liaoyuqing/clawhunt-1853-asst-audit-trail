# 所有配置与密钥只从环境变量读取；本文件只是变量清单，不含任何真实密钥。
# 复制为 .env 仅为本地参考，程序本身不读取 .env，请用 shell / systemd / 容器注入。

# 必填：留痕原文加密密钥。32 字节 base64、64 位 hex、或任意长度口令（口令会被 HKDF-SHA256 派生）
ASST_TRAIL_KEY=
# 可选：导出下载链接签名密钥，缺省时由 ASST_TRAIL_KEY 经 HKDF 派生
ASST_EXPORT_SIGNING_KEY=
# 数据库连接串；生产为 PostgreSQL 15+（pgvector 扩展可选），测试默认 sqlite 文件
ASST_DATABASE_URL=postgresql+psycopg://asst_app:<password>@<host>:5432/asst
# 连接池大小（仅非 SQLite 生效）
ASST_DB_POOL_SIZE=10
# 留痕保留期（天），默认 180
ASST_LOG_RETENTION_DAYS=180
# 每次清理的批量大小
ASST_PURGE_BATCH_SIZE=1000
# 导出文件落盘目录
ASST_EXPORT_DIR=./var/exports
# 下载链接对外基址（反代后的公网地址）
ASST_PUBLIC_BASE_URL=http://127.0.0.1:8000
# 导出下载链接有效期（秒），需求写死 10 分钟
ASST_EXPORT_URL_TTL_SECONDS=600
# 导出单文件上限（行），超出分片
ASST_EXPORT_MAX_ROWS=100000
# 导出队列实现：inline（同步跑，测试用） / thread（进程内线程） / redis（跨进程 worker）
ASST_EXPORT_QUEUE=thread
# ASST_EXPORT_QUEUE=redis 时必填：Redis 连接串（含 db 号，建议专用 db 与 key 前缀）
ASST_REDIS_URL=redis://:<password>@<host>:6379/0
# 队列键前缀，便于与其它业务隔离与清理
ASST_REDIS_KEY_PREFIX=asst1853:
# worker 阻塞取任务的超时（秒）
ASST_REDIS_BRPOP_TIMEOUT=5

# ---- 仅测试用（pytest 读取；生产不需要） ----
# 给出时整份 pytest 改跑真实 PostgreSQL，每个用例建独立 schema 并在结束时 DROP
ASST_TEST_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
# 给出时 Redis 队列用例才真正连队列，否则整组 skip
ASST_TEST_REDIS_URL=redis://:<password>@<host>:6379/5
